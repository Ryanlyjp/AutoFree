# AutoFree fallback config. Most settings can be edited from the web UI
# (data/settings.json takes precedence over env). Only the API auth key
# really needs to live here.

# Bearer key required by the FastAPI backend.
AUTOFREE_API_KEY=change-me

# Optional fallback values used the first time settings.json is created.
# All of these are editable from the web UI afterwards.

# Mail provider: cf_temp_email | maillab | tempmail
MAIL_PROVIDER=tempmail

# cf_temp_email (dreamhunter2333/cloudflare_temp_email)
CLOUDMAIL_BASE_URL=
CLOUDMAIL_PASSWORD=
CLOUDMAIL_DOMAIN=

# maillab (maillab/cloud-mail)
MAILLAB_API_URL=
MAILLAB_USERNAME=
MAILLAB_PASSWORD=
MAILLAB_DOMAIN=

# tempmail (self-hosted, /opt/code-server/project/tempmail)
TEMPMAIL_BASE_URL=
TEMPMAIL_API_KEY=
TEMPMAIL_DOMAIN=

# CLIProxyAPI push target (manual push from the web UI).
CPA_BASE_URL=
CPA_KEY=

# Outbound HTTP/HTTPS proxy used by Playwright. Editable from the web UI.
HTTP_PROXY=
